#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>

typedef struct {
    int *items;
    size_t size;
    size_t capacity;
} IntArray;

static void int_array_init(IntArray *array) {
    array->items = NULL;
    array->size = 0;
    array->capacity = 0;
}

static void int_array_destroy(IntArray *array) {
    free(array->items);
    array->items = NULL;
    array->size = 0;
    array->capacity = 0;
}

static int int_array_reserve(IntArray *array, size_t new_capacity) {
    if (new_capacity <= array->capacity) {
        return 0;
    }

    int *new_items = realloc(array->items, new_capacity * sizeof(*new_items));
    if (new_items == NULL) {
        return -1;
    }

    array->items = new_items;
    array->capacity = new_capacity;
    return 0;
}

static int int_array_push(IntArray *array, int value) {
    if (array->size == array->capacity) {
        size_t next_capacity = array->capacity == 0 ? 4 : array->capacity * 2;
        if (int_array_reserve(array, next_capacity) != 0) {
            return -1;
        }
    }

    array->items[array->size++] = value;
    return 0;
}

static char *duplicate_string(const char *source) {
    size_t length = strlen(source) + 1;
    char *copy = malloc(length);
    if (copy == NULL) {
        return NULL;
    }

    memcpy(copy, source, length);
    return copy;
}

int main(void) {
    IntArray numbers;
    int_array_init(&numbers);

    char *label = duplicate_string("dynamic integer array");
    if (label == NULL) {
        fprintf(stderr, "Failed to allocate label: %s\n", strerror(errno));
        return EXIT_FAILURE;
    }

    for (int i = 1; i <= 10; ++i) {
        if (int_array_push(&numbers, i * i) != 0) {
            fprintf(stderr, "Failed to grow array: %s\n", strerror(errno));
            free(label);
            int_array_destroy(&numbers);
            return EXIT_FAILURE;
        }
    }

    printf("%s (%zu items, capacity %zu):\n", label, numbers.size, numbers.capacity);
    for (size_t i = 0; i < numbers.size; ++i) {
        printf("  numbers[%zu] = %d\n", i, numbers.items[i]);
    }

    /* Always release owned heap memory once it is no longer needed. */
    free(label);
    int_array_destroy(&numbers);

    return EXIT_SUCCESS;
}
